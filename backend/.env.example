# Django
DJANGO_SETTINGS_MODULE=config.settings.development
DJANGO_SECRET_KEY=change-me-in-production
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Database — Neon PostgreSQL (production). Leave unset locally to use SQLite for scaffold checks.
# DATABASE_URL=postgresql://user:pass@ep-xxx.neon.tech/veni?sslmode=require

# CORS / CSRF (Vite dev)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Email / notifications (console by default; set SMTP for real delivery)
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
VENI_NOTIFICATIONS_CONSOLE=true
DEFAULT_FROM_EMAIL=noreply@veni.local
# EMAIL_HOST=
# EMAIL_PORT=587
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=
# EMAIL_USE_TLS=true

# AWS S3 (Phase 3+)
AWS_REGION=ap-south-1
AWS_S3_BUCKET_NAME=veni-private-assets
PRODUCT_IMAGE_STORAGE_BACKEND=memory
PRODUCT_IMAGE_MAX_BYTES=5242880
# Use EC2 instance profile in production; optional keys for local dev only:
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=

# Manual bank transfer details (shown on order payment panel)
VENI_PAYMENT_BANK_NAME=Meezan Digital Centre
VENI_PAYMENT_ACCOUNT_TITLE=SHAHAN ALI
VENI_PAYMENT_ACCOUNT_NUMBER=00300112202336
VENI_PAYMENT_IBAN=PK27MEZN0000300112202336
