# Copy to /var/www/veni/backend/.env on the EC2 host. Never commit real secrets.

DJANGO_SETTINGS_MODULE=config.settings.production
DJANGO_SECRET_KEY=replace-with-long-random-secret
DJANGO_ALLOWED_HOSTS=yourdomain.com,www.yourdomain.com
# Alias supported by production.py:
# ALLOWED_HOSTS=yourdomain.com,www.yourdomain.com

DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxx.neon.tech/veni?sslmode=require

# Public site origin(s) — must match Nginx / browser URL (https after Certbot)
CORS_ALLOWED_ORIGINS=https://yourdomain.com
CSRF_TRUSTED_ORIGINS=https://yourdomain.com

# AWS private bucket (ADR-0005) — prefer EC2 instance profile; keys optional
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET_NAME=veni-private-assets
AWS_REGION=ap-south-1
# Aliases supported by production.py:
# AWS_STORAGE_BUCKET_NAME=veni-private-assets
# AWS_S3_REGION_NAME=ap-south-1

PRODUCT_IMAGE_MAX_BYTES=5242880
PAYMENT_PROOF_MAX_BYTES=5242880
S3_PRESIGN_UPLOAD_EXPIRY=3600
S3_PRESIGN_READ_EXPIRY=900

# Optional: Veni manual payment copy (defaults exist in settings)
# VENI_PAYMENT_BANK_NAME=
# VENI_PAYMENT_ACCOUNT_NUMBER=
# VENI_MANUAL_PAYMENT_INSTRUCTIONS=

# Frontend build (run on server before npm run build)
VITE_API_BASE_URL=/api/v1

# Optional Django TLS redirect (usually false — Nginx + Certbot handle HTTPS)
# DJANGO_SECURE_SSL_REDIRECT=false
# DJANGO_LOG_LEVEL=INFO
